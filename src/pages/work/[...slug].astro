---
import { getCollection, render } from 'astro:content';
import MainLayout from '@/layouts/main-layout.astro';
import ProjectVisual from '@/components/project-visual.astro';
import Contact from '@/components/sections/contact.astro';
export async function getStaticPaths() {
  const projects = await getCollection('work', ({data}) => !data.draft && !data.protected);
  return projects.map(project => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const data = project.data;
const all = (await getCollection('work', ({data}) => !data.draft && !data.protected)).sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const next = all[(all.findIndex(item => item.id === project.id) + 1) % all.length];
const parent = data.kind === 'independent' ? '/builds' : '/work';
---
<MainLayout title={data.title} description={data.description} image={data.cover} noindex={data.editorial}>
  <article class="shell" data-case-study>
    <header class="case-header"><a href={parent} class="back-link">← {data.kind === 'independent' ? 'Independent builds' : 'Selected work'}</a><p class="eyebrow">{data.eyebrow}</p><h1>{data.title}</h1><p class="case-lead">{data.summary ?? data.description}</p>
      {data.editorial && <aside class="editorial-banner"><strong>Story preview.</strong> This page includes sample narrative for review. Illustrations, proposed decisions and evidence prompts are identified in the story; they are not claims of measured results.</aside>}
    </header>
    <div class="case-cover"><ProjectVisual variant={data.visual} eager /></div>
    {data.video && <details class="media-preview"><summary>Watch the existing product preview</summary><video controls playsinline preload="none" poster={data.cover} aria-label={`${data.title} product preview`}><source src={data.video} type="video/mp4" /><a href={data.video}>Download the product preview</a></video><p class="sample-label">Silent interface walkthrough. The cover shows the health overview, appointments and report screens.</p></details>}
    <dl class="case-meta"><div><dt>My role</dt><dd>{data.role}</dd></div><div><dt>Context</dt><dd>{data.company}</dd></div><div><dt>Timeframe</dt><dd>{data.duration}</dd></div><div><dt>Project type</dt><dd>{data.status}</dd></div></dl>
    <div class="case-layout"><aside class="case-toc"><p class="eyebrow">Inside the story</p><nav aria-label="Case study contents">{headings.filter(item => item.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></aside><div class="case-prose"><Content /><div data-article-end></div></div></div>
    {next && next.id !== project.id && <a class="next-case" href={`/work/${next.id}`} data-track="Case study open"><div><p class="eyebrow">Next story</p><strong>{next.data.title}</strong></div><span aria-hidden="true">↗</span></a>}
  </article><Contact />
</MainLayout>
