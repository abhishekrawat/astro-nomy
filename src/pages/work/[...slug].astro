---
import { getCollection, render } from 'astro:content';
import MainLayout from '@/layouts/main-layout.astro';
import ProjectVisual from '@/components/project-visual.astro';
import Contact from '@/components/sections/contact.astro';
import VideoPreview from '@/components/story/video-preview.astro';
import WorkflowPreview from '@/components/story/workflow-preview.astro';
export async function getStaticPaths() {
  const projects = await getCollection('work', ({data}) => !data.draft && !data.protected);
  return projects.map(project => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const data = project.data;
const all = (await getCollection('work', ({data}) => !data.draft && !data.protected)).sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const next = all[(all.findIndex(item => item.id === project.id) + 1) % all.length];
const parent = data.kind === 'independent' ? '/builds' : '/work';
const chapterHeadings = headings.filter(item => item.depth === 2);
const readingMinutes = Math.max(2, Math.ceil((project.body ?? '').split(/\s+/).length / 200));
---
<MainLayout title={data.title} description={data.description} image={data.cover} noindex={data.editorial}>
  <article class="shell" data-case-study>
    <header class="case-header story-header"><a href={parent} class="back-link">← {data.kind === 'independent' ? 'Independent builds' : 'Selected work'}</a><p class="eyebrow">{data.eyebrow}</p><h1>{data.title}</h1><p class="case-lead">{data.summary ?? data.description}</p>
      <p class="story-kicker">{readingMinutes} min read <span aria-hidden="true">·</span> A story in {chapterHeadings.length} chapters</p>
    </header>
    <div class="story-hero">{data.video ? <VideoPreview src={data.video} label={`${data.title} silent product walkthrough`} /> : data.visual === 'ai' ? <WorkflowPreview /> : <ProjectVisual variant={data.visual} eager />}</div>
    <div class="story-summary">
    {data.video && <a class="text-link" href={data.video}>Open the full silent walkthrough ↗</a>}
    <dl class="case-meta"><div><dt>My role</dt><dd>{data.role}</dd></div><div><dt>Context</dt><dd>{data.company}</dd></div><div><dt>Timeframe</dt><dd>{data.duration}</dd></div><div><dt>Project type</dt><dd>{data.status}</dd></div></dl>
    {data.editorial && <aside class="editorial-banner"><strong>Story preview.</strong> Sample narrative and illustrative artifacts await your review. They are not evidence of measured results. Existing project media is identified separately.</aside>}
    </div>
    <div class="story-navigation"><nav aria-label="Case study chapters">{chapterHeadings.map((heading, index) => <a href={`#${heading.slug}`}><span>{String(index + 1).padStart(2, '0')}</span>{heading.text}</a>)}</nav></div>
    <div class="story-body"><Content /><div data-article-end></div></div>
    {next && next.id !== project.id && <a class="next-case" href={`/work/${next.id}`} data-track="Case study open"><div><p class="eyebrow">Next story</p><strong>{next.data.title}</strong></div><span aria-hidden="true">↗</span></a>}
  </article><Contact />
</MainLayout>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.story-navigation a')];
  const chapters = links.map(link => document.getElementById(decodeURIComponent(link.hash.slice(1)))).filter((heading): heading is HTMLElement => Boolean(heading));
  let scheduled = false;
  function updateChapter() {
    scheduled = false;
    const current = [...chapters].reverse().find(heading => heading.getBoundingClientRect().top <= 190) ?? chapters[0];
    links.forEach(link => {
      if (link.hash === `#${current?.id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  document.addEventListener('scroll', () => { if (!scheduled) { scheduled = true; requestAnimationFrame(updateChapter); } }, { passive: true });
  updateChapter();
</script>
