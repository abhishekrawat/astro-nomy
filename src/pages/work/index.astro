---
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/main-layout.astro";
import { Badge } from "@/components/ui/badge";
import { Icon } from "astro-icon/components";

const allWork = await getCollection("work");
const sorted = allWork.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const featured = sorted.filter((p) => p.data.featured);
const other    = sorted.filter((p) => !p.data.featured);
---

<MainLayout title="Work" description="Selected case studies in healthcare and e-commerce UX design.">
  <section class="container max-w-screen-md py-16 sm:py-20">

    <div class="mb-14" data-animate>
      <h1 class="text-4xl font-heading mb-3">Selected Work</h1>
      <p class="text-muted-foreground text-base max-w-xl">
        A curated collection of healthcare and product design case studies. Each project
        documents the problem, process, decisions, and outcomes.
      </p>
    </div>

    <!-- Featured projects -->
    {featured.length > 0 && (
      <div class="space-y-6 mb-16">
        {featured.map((project, i) => (
          <a
            href={`/work/${project.id}`}
            data-animate
            data-delay={String(i + 1)}
            class="group block border rounded-xl overflow-hidden hover:border-foreground/20 transition-colors duration-300 hover:shadow-md dark:hover:shadow-none"
          >
            <div class="img-hover-zoom w-full h-52 bg-muted flex items-center justify-center text-muted-foreground text-sm">
              {project.data.cover
                ? <img src={project.data.cover} alt={project.data.title} class="w-full h-full object-cover" transition:name={`work-img-${project.id}`} />
                : <span class="text-xs">Cover image coming soon</span>
              }
            </div>

            <div class="p-6">
              <div class="flex flex-wrap gap-2 mb-3">
                {project.data.tags.slice(0, 4).map((tag) => (
                  <Badge variant="secondary">{tag}</Badge>
                ))}
              </div>

              <div class="flex items-start justify-between gap-4">
                <h2 class="text-2xl font-heading mb-1" transition:name={`work-title-${project.id}`}>
                  {project.data.title}
                </h2>
                <Icon
                  name="lucide:arrow-up-right"
                  class="size-5 text-muted-foreground flex-shrink-0 mt-1 opacity-0 group-hover:opacity-100 transition-opacity duration-200 -translate-x-1 group-hover:translate-x-0 translate-y-1 group-hover:translate-y-0"
                  style="transition: opacity 200ms, transform 250ms cubic-bezier(0.16,1,0.3,1)"
                />
              </div>

              <p class="text-sm text-muted-foreground mb-4">{project.data.description}</p>

              <div class="flex flex-wrap gap-x-6 gap-y-1 text-xs text-muted-foreground">
                <span><strong class="text-foreground">Role:</strong> {project.data.role}</span>
                <span><strong class="text-foreground">Company:</strong> {project.data.company}</span>
                <span><strong class="text-foreground">Duration:</strong> {project.data.duration}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    )}

    <!-- Other projects -->
    {other.length > 0 && (
      <div data-animate>
        <h2 class="text-xl font-heading mb-6 text-muted-foreground">More Projects</h2>
        <div class="space-y-0">
          {other.map((project, i) => (
            <a
              href={`/work/${project.id}`}
              data-animate
              data-delay={String(i + 1)}
              class="group flex items-center justify-between border-b py-4 px-2 -mx-2 rounded-md hover:bg-muted/40 hover:border-foreground/20 transition-colors duration-200"
            >
              <div>
                <h3 class="font-medium mb-0.5 link-underline inline">{project.data.title}</h3>
                <p class="text-sm text-muted-foreground mt-0.5">{project.data.company} · {project.data.category}</p>
              </div>
              <div class="flex items-center gap-3">
                <div class="hidden sm:flex flex-wrap gap-1.5">
                  {project.data.tags.slice(0, 2).map((tag) => (
                    <Badge variant="outline" className="text-xs">{tag}</Badge>
                  ))}
                </div>
                <Icon
                  name="lucide:arrow-right"
                  class="size-4 text-muted-foreground opacity-0 group-hover:opacity-100 -translate-x-1 group-hover:translate-x-0 transition-all duration-200"
                />
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {allWork.length === 0 && (
      <p class="text-muted-foreground">No case studies published yet. Check back soon.</p>
    )}

  </section>
</MainLayout>
