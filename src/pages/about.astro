---
import MainLayout from "@/layouts/main-layout.astro";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";

/**
 * NOTE — Sections hidden until real content exists (restore from git history):
 * - "Impact at a Glance" (leadership stats)
 * - "Design Philosophy" (3 principles)
 * - "What people say" (testimonials)
 * Placeholder content read as fake and hurt credibility more than absence.
 */

const skills = {
  "Healthcare UX": [
    "Clinical workflow design",
    "EHR / EMR systems",
    "Patient portal design",
    "Health information exchange (HIE)",
    "HIPAA-compliant design",
    "Medical device UX",
  ],
  "Research & Strategy": [
    "Contextual inquiry",
    "Stakeholder interviews",
    "Usability testing",
    "Heuristic evaluation",
    "Journey mapping",
    "Service blueprinting",
  ],
  "Design & Tools": [
    "Figma",
    "Prototyping & interaction design",
    "Design systems",
    "Accessibility (WCAG 2.2)",
    "Arabic RTL design",
    "Framer",
  ],
  "AI & Automation": [
    "Design-to-code with AI (Figma Code Connect)",
    "RAG knowledge systems & chatbots",
    "Internal AI tooling",
    "AI content pipelines (Strapi)",
    "AI-assisted prototyping",
  ],
};

const experience = [
  {
    role: "Lead UX Designer",
    company: "Malaffi / Department of Health, Abu Dhabi",
    period: "Current",
    description:
      "Leading design for the patient-facing portal of Abu Dhabi's Health Information Exchange — clinical records made accessible and understandable, in Arabic and English, for 3M+ residents. Drove an AI-assisted upgrade of the Figma design system to Code Connect across all components, cutting design-dev handoff friction.",
  },
];
---

<MainLayout
  title="About"
  description="Lead Healthcare UX Designer based in Abu Dhabi — designing clinical systems that improve patient outcomes and reduce clinician burden."
>
  <div class="container max-w-screen-md">

    <!-- Hero -->
    <section class="py-16 sm:py-20">
      <p class="mb-3 text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground/60">
        About
      </p>
      <h1 class="font-heading tracking-[-0.02em] text-4xl sm:text-5xl mb-4">Abhishek Rawat</h1>
      <p class="text-xl text-muted-foreground mb-2">
        Lead UX Designer · Healthcare &amp; Product
      </p>
      <p class="text-sm text-muted-foreground mb-8">
        Based in Abu Dhabi, UAE · Working at Malaffi, Department of Health
      </p>

      <div class="prose prose-neutral dark:prose-invert max-w-none prose-p:text-muted-foreground">
        <p>
          I'm a Lead UX Designer specialising in healthcare systems — the intersection of
          clinical workflows, patient-facing products, and the technology that connects them.
        </p>
        <p>
          I design for the Abu Dhabi health ecosystem at Malaffi, the region's Health
          Information Exchange, where the products I work on serve over three million
          residents in Arabic and English.
        </p>
        <p>
          I'm also part of our internal AI guild, building tools that make the whole team
          faster: an AI-assisted upgrade of our Figma design system to Code Connect across
          every component — cutting design-dev handoff friction — a RAG-powered knowledge
          repository and chatbot, and AI pipelines for content operations in Strapi.
        </p>
        <p>
          Outside of design, I'm a skydiving coach — which has taught me a lot about operating
          under pressure, trusting systems, and the real cost of bad UX when the stakes are high.
        </p>
      </div>

      <div class="flex gap-3 mt-8">
        <a
          href={`mailto:abhishek@rawat.dev`}
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border text-sm font-medium hover:bg-muted transition-colors"
        >
          <Icon name="lucide:mail" class="size-4" />
          Email me
        </a>
        <a
          href={siteConfig.links.linkedin}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border text-sm font-medium hover:bg-muted transition-colors"
        >
          <Icon name="linkedin" class="size-4" />
          LinkedIn
        </a>
        <a
          href={siteConfig.links.resume}
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border text-sm font-medium hover:bg-muted transition-colors"
        >
          <Icon name="download" class="size-4" />
          Resume
        </a>
      </div>
    </section>

    <hr class="border-border" />

    <!-- Skills & Expertise -->
    <section class="py-14">
      <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground/60" data-animate>
        Capabilities
      </p>
      <h2 class="text-2xl font-heading mb-2" data-animate>Skills &amp; Expertise</h2>
      <p class="text-muted-foreground text-sm mb-8" data-animate data-delay="1">
        Domain knowledge and tools I bring to every engagement.
      </p>
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {Object.entries(skills).map(([category, items], i) => (
          <div data-animate data-delay={String(i + 1)}>
            <h3 class="font-medium text-sm uppercase tracking-wide text-muted-foreground mb-3">
              {category}
            </h3>
            <ul class="space-y-2">
              {items.map((skill) => (
                <li class="text-sm flex items-center gap-2">
                  <span class="size-1 rounded-full bg-foreground/30 flex-shrink-0" />
                  {skill}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-border" />

    <!-- Experience -->
    <section class="py-14">
      <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground/60" data-animate>
        Track record
      </p>
      <h2 class="text-2xl font-heading mb-8" data-animate>Experience</h2>
      <div class="space-y-8">
        {experience.map((item, i) => (
          <div class="grid sm:grid-cols-[180px_1fr] gap-2 sm:gap-8" data-animate data-delay={String(Math.min(i + 1, 4))}>
            <div class="text-sm text-muted-foreground pt-0.5">{item.period}</div>
            <div>
              <p class="font-medium">{item.role}</p>
              <p class="text-sm text-muted-foreground mb-2">{item.company}</p>
              <p class="text-sm text-muted-foreground leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-border" />

    <!-- Contact CTA -->
    <section class="py-14">
      <p class="mb-3 flex items-center gap-2 text-xs text-muted-foreground" data-animate>
        <span class="availability-dot" aria-hidden="true"></span>
        Open to lead design roles
      </p>
      <h2 class="text-2xl font-heading mb-3" data-animate>Let's work together</h2>
      <p class="text-muted-foreground text-base mb-6 max-w-md" data-animate data-delay="1">
        Based in Abu Dhabi, available for remote collaboration globally.
      </p>
      <a
        href={`mailto:abhishek@rawat.dev`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-foreground text-background text-sm font-medium hover:opacity-90 transition-opacity"
      >
        <Icon name="lucide:mail" class="size-4" />
        Get in touch
      </a>
    </section>

  </div>
</MainLayout>
