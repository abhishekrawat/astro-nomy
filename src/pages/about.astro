    "Arabic RTL design",
    "Framer",
  ],
};

const philosophy = [
  {
    title: "TODO: Principle 1",
    description:
      "TODO: Describe your first design principle. e.g., 'In healthcare, every design decision has a human consequence. I design for the person first, the pixel second.'",
  },
  {
    title: "TODO: Principle 2",
    description:
      "TODO: Describe your second principle. e.g., 'Good UX is invisible. The goal is a clinical workflow so natural that nurses don't have to think — they just act.'",
  },
  {
    title: "TODO: Principle 3",
    description:
      "TODO: Describe your third principle. e.g., 'Context is everything. A design that works for a patient at home fails for a clinician in an ICU. I design for environment, not just persona.'",
