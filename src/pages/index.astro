---
import HeroLanding from "@/components/sections/hero-landing.astro";
import LogoBar from "@/components/sections/logo-bar.astro";
import FeaturedWork from "@/components/sections/featured-work.astro";
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/main-layout.astro";

// Compact list: work not shown as a featured card (drafts included — breadth
// of experience without linking to unfinished case studies).
const allWork = await getCollection("work");
const otherWork = allWork
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .filter((p) => p.data.draft || !p.data.featured);
---

<MainLayout title="Abhishek Rawat - Product Designer">
  <HeroLanding />
  <LogoBar />

  <FeaturedWork />

  <!-- Selected work — compact, non-linked rows -->
  {otherWork.length > 0 && (
    <section class="container py-12 max-w-screen-lg border-t">
      <div class="mb-8" data-animate>
        <p class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-muted-foreground/60">
          Also shipped
        </p>
        <h2 class="text-2xl font-heading">Selected Work</h2>
      </div>

      <ul>
        {otherWork.map((project, i) => (
          <li
            class="flex flex-col gap-1 border-b py-5 last:border-0 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
            data-animate
            data-delay={String(Math.min(i + 1, 4))}
          >
            <div class="min-w-0">
              <h3 class="text-lg font-medium">{project.data.title}</h3>
              <p class="mt-0.5 text-sm text-muted-foreground">
                {project.data.description}
              </p>
            </div>
            <p class="flex-shrink-0 text-xs text-muted-foreground/70 sm:text-right">
              {project.data.company} · {project.data.category}
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}
</MainLayout>
