---
import MainLayout from '@/layouts/main-layout.astro';
import Hero from '@/components/sections/hero-landing.astro';
import FeaturedWork from '@/components/sections/featured-work.astro';
import Leadership from '@/components/sections/leadership.astro';
import ProjectCard from '@/components/project-card.astro';
import Contact from '@/components/sections/contact.astro';
import WorkbenchPhoto from '@/components/story/workbench-photo.astro';
import { getCollection } from 'astro:content';
const builds = (await getCollection('work', ({data}) => !data.draft && data.kind === 'independent')).sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
---
<MainLayout title="Healthcare Product Design Lead, Abu Dhabi" description="Abhishek Rawat is a healthcare product design lead in Abu Dhabi. Explore patient-centred health experiences, clinical UX, design systems and AI-assisted delivery case studies.">
  <Hero />
  <section class="trust-proof shell" aria-labelledby="organisations-title">
    <div class="trust-proof-heading"><h2 id="organisations-title">Organisations I’ve designed for</h2></div>
    <ul class="trust-marks" role="list">
      <li>Malaffi</li>
      <li>Department of Health</li>
      <li>ADAFSA</li>
      <li>Landmark Group</li>
      <li>Fab.com</li>
    </ul>
  </section>
  <FeaturedWork />
  <Leadership />
  <section class="builds-section section-space" aria-labelledby="builds-title"><div class="shell"><div class="section-heading"><div><p class="eyebrow">Beyond the screen / independent builds</p><h2 id="builds-title">Curiosity,<br/><span class="serif-accent">made tangible.</span></h2></div><div><p>I build to understand. Small devices, real constraints, and the long journey from an idea to something you can hold.</p><a href="/builds" class="text-link">Inside the workshop <span class="link-arrow" aria-hidden="true">↗</span></a></div></div><figure class="workbench-intro"><WorkbenchPhoto /><figcaption>Workbench study · AI-generated concept, awaiting real build photography.</figcaption></figure><div class="project-grid">{builds.map((project,index) => <ProjectCard project={project} index={index} />)}</div></div></section>
  <section class="shell section-space writing-section" aria-labelledby="writing-title"><div class="section-heading"><div><p class="eyebrow">Notes on the work</p><h2 id="writing-title">Thinking <span class="serif-accent">out loud.</span></h2></div><a href="/blog" class="text-link">All writing <span class="link-arrow" aria-hidden="true">↗</span></a></div><div class="writing-list">{posts.map((post,index) => <a href={`/blog/${post.id}`}><span class="writing-number">0{index+1}</span><div><p class="eyebrow">{post.data.category} {post.data.editorial && ' / Sample essay'}</p><h3>{post.data.title}</h3></div><span aria-hidden="true">↗</span></a>)}</div></section>
  <Contact />
</MainLayout>
