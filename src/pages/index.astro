---
import HeroLanding from "@/components/sections/hero-landing.astro";
import LogoBar from "@/components/sections/logo-bar.astro";
import { getCollection } from "astro:content";
import MainLayout from "@/layouts/main-layout.astro";
import { Badge } from "@/components/ui/badge";

// Featured work
const allWork = await getCollection("work");
const featuredWork = allWork
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99))
  .filter((p) => p.data.featured)
  .slice(0, 3);

// Latest blog posts
const posts = await getCollection("blog");
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const topPosts = posts.slice(0, 3);

const dateOptions: Intl.DateTimeFormatOptions = { day: "2-digit", month: "short", year: "numeric" };
---

<MainLayout title="">
  <HeroLanding />
  <LogoBar />

  <!-- Featured Work -->
  <section class="container py-16 max-w-screen-md">
    <div class="flex items-center justify-between mb-8" data-animate>
      <h2 class="text-2xl font-heading">Featured Work</h2>
      <a href="/work" class="text-sm text-muted-foreground hover:text-foreground transition-colors link-underline">
        View all →
      </a>
    </div>

    {featuredWork.length > 0 ? (
      <div class="space-y-4">
        {featuredWork.map((project, i) => (
          <a
            href={`/work/${project.id}`}
            data-animate
            data-delay={String(i + 1)}
            class="group flex flex-col sm:flex-row gap-4 border rounded-xl p-5 hover:border-foreground/20 hover:shadow-sm dark:hover:shadow-none transition-all duration-300"
          >
            <div class="img-hover-zoom w-full sm:w-32 h-24 rounded-lg bg-muted flex-shrink-0">
              {project.data.cover ? (
                <img src={project.data.cover} alt={project.data.title} class="w-full h-full object-cover rounded-lg" />
              ) : (
                <div class="w-full h-full bg-muted rounded-lg" />
              )}
            </div>

            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap gap-1.5 mb-2">
                {project.data.tags.slice(0, 3).map((tag) => (
                  <Badge variant="secondary" className="text-xs">{tag}</Badge>
                ))}
              </div>
              <h3 class="font-medium mb-1 link-underline inline-block">
                {project.data.title}
              </h3>
              <p class="text-sm text-muted-foreground line-clamp-2">{project.data.description}</p>
              <p class="text-xs text-muted-foreground mt-2">{project.data.company} · {project.data.role}</p>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground text-sm">Case studies coming soon.</p>
    )}
  </section>

  <!-- Latest Writing -->
  <section class="container py-12 max-w-screen-md border-t">
    <div class="flex items-center justify-between mb-8" data-animate>
      <h2 class="text-2xl font-heading">Latest Writing</h2>
      <a href="/blog" class="text-sm text-muted-foreground hover:text-foreground transition-colors link-underline">
        View all →
      </a>
    </div>

    {topPosts.length > 0 ? (
      <ul>
        {topPosts.map((post, i) => (
          <li class="group border-b last:border-0" data-animate data-delay={String(i + 1)}>
            <a href={`/blog/${post.id}`} class="block py-5">
              <h3 class="text-lg font-medium mb-1 link-underline inline-block">
                {post.data.title}
              </h3>
              <p class="text-sm text-muted-foreground mb-1.5">{post.data.description}</p>
              <p class="text-xs text-muted-foreground">
                {new Date(post.data.pubDate).toLocaleDateString("en-gb", dateOptions)}
              </p>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted-foreground text-sm">No posts yet. Check back soon.</p>
    )}
  </section>
</MainLayout>
