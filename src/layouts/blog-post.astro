---
import type { CollectionEntry } from 'astro:content';
import MainLayout from './main-layout.astro';
import { siteConfig } from '@/config/site';
import { getReadingTime, formatDate } from '@/lib/utils';
type Props = CollectionEntry<'blog'>;
const { id, data, body } = Astro.props;
const url = new URL(`/blog/${id}`, siteConfig.url).href;
const articleSchema = {
  "@type": "BlogPosting", "@id": `${url}#article`, headline: data.title, description: data.description,
  url, mainEntityOfPage: { "@id": `${url}#webpage` }, datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
  author: { "@id": new URL("/#person", siteConfig.url).href }, publisher: { "@id": new URL("/#person", siteConfig.url).href },
  inLanguage: "en-AE",
};
---
<MainLayout title={data.title} description={data.description} noindex={data.editorial} type="article" publishedTime={data.pubDate} modifiedTime={data.updatedDate} structuredData={data.editorial ? [] : [articleSchema]}>
  <div class="shell"><article class="article-shell"><header class="page-intro"><a href="/blog" class="back-link">← All writing</a><p class="eyebrow">{data.category}</p><h1>{data.title}</h1><p>{data.description}</p></header><div class="article-meta"><span>Abhishek Rawat</span><time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time><span>{getReadingTime(body ?? '')} min read</span></div>
    {data.editorial && <aside class="editorial-banner"><strong>Sample essay.</strong> Drafted for the portfolio’s editorial direction. Replace or review before publishing as a personal account.</aside>}
    <div class="case-prose"><slot /></div>
    <div class="share-row"><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noreferrer">Share on LinkedIn ↗</a><button type="button" data-copy-link={url} hidden>Copy link</button><span class="share-status" aria-live="polite"></span></div>
  </article></div>
</MainLayout>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const status = document.querySelector('.share-status');
      try { await navigator.clipboard.writeText(button.dataset.copyLink!); if (status) status.textContent = 'Link copied.'; }
      catch { if (status) status.textContent = 'Copy the page address from your browser to share this essay.'; }
    });
  });
</script>
