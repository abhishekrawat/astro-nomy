---
import BaseHead from "@/components/layout/base-head.astro";
interface Props { title: string; description?: string; image?: string; noindex?: boolean; bodyClass?: string; }
const { bodyClass, ...head } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...head} />
    <script>
      import '@/scripts/page-transitions';
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
