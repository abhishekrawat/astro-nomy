---
import { Badge } from "@/components/ui/badge";
import { formatDate } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const id = post.id;
---

<article class="group space-y-4">
  <a
    href={`/blog/${id}/`}
    class="img-hover-zoom flex h-52 rounded-xl group-hover:-translate-y-1.5 group-hover:shadow-lg transition-all duration-300 ease-spring"
  >
    {post.data.cover ? (
      <img
        loading="eager"
        class="w-full h-full object-cover rounded-xl overflow-hidden"
        width={720}
        height={360}
        src={post.data.cover}
        alt={post.data.title}
        transition:name={`img-${id}`}
      />
    ) : (
      <div class="w-full h-full rounded-xl bg-muted" transition:name={`img-${id}`} />
    )}
  </a>

  <div class="flex items-center justify-between">
    <a
      href={`/blog/category/${post.data.category}`}
      transition:name={"badge-cat-" + id}
    >
      <Badge radius="md" className="capitalize">
        {post.data.category}
      </Badge>
    </a>
    <span
      class="font-medium text-muted-foreground"
      transition:name={"date-" + id}
    >
      {formatDate(post.data.pubDate)}
    </span>
  </div>

  <div>
    <a href={`/blog/${id}/`} class="group-hover:underline">
      <h2
        class="font-heading text-xl md:text-2xl leading-snug line-clamp-3"
        transition:name={"title-" + id}
      >
        {post.data.title}
      </h2>
    </a>
  </div>
</article>
