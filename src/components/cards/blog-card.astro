---
import { formatDate, getReadingTime } from "@/lib/utils";
import type { CollectionEntry } from "astro:content";

type Props = CollectionEntry<"blog">;

const post = Astro.props;
const id = post.id;
const readingTime = getReadingTime(post.body ?? "");
const coverSrc = post.data.cover ?? `https://picsum.photos/seed/${id}/720/405`;
---

<article class="group flex flex-col gap-4">

  {/* Cover image */}
  <a
    href={`/blog/${id}/`}
    class="img-hover-zoom block aspect-[16/9] rounded-xl overflow-hidden bg-muted flex-shrink-0"
  >
    <img
      loading="lazy"
      class="w-full h-full object-cover"
      width={720}
      height={405}
      src={coverSrc}
      alt={post.data.title}
      transition:name={`img-${id}`}
    />
  </a>

  {/* Meta row */}
  <div class="flex items-center gap-2 text-xs text-muted-foreground">
    <a
      href={`/blog/category/${post.data.category}`}
      class="capitalize font-medium text-foreground/70 hover:text-foreground transition-colors duration-200"
      transition:name={`badge-cat-${id}`}
    >
      {post.data.category}
    </a>
    <span aria-hidden="true">·</span>
    <span transition:name={`date-${id}`}>{formatDate(post.data.pubDate)}</span>
    <span aria-hidden="true">·</span>
    <span>{readingTime} min read</span>
  </div>

  {/* Title + description */}
  <div class="flex-1 flex flex-col gap-2">
    <a href={`/blog/${id}/`}>
      <h2
        class="font-heading text-xl leading-snug line-clamp-2 group-hover:opacity-70 transition-opacity duration-200"
        transition:name={`title-${id}`}
      >
        {post.data.title}
      </h2>
    </a>
    <p class="text-sm text-muted-foreground line-clamp-2 leading-relaxed">
      {post.data.description}
    </p>
  </div>

</article>
