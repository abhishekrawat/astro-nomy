---
import { getCollection } from 'astro:content';
import VideoPreview from '@/components/story/video-preview.astro';
import WorkflowPreview from '@/components/story/workflow-preview.astro';
import ProjectVisual from '@/components/project-visual.astro';
const work = (await getCollection('work', ({data}) => !data.draft && data.kind === 'professional' && data.featured)).sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<section class="shell section-space" id="selected-work" aria-labelledby="work-title">
  <div class="section-heading"><div><p class="eyebrow">Selected work</p><h2 id="work-title">Complex challenges.<br/><span class="serif-accent">Considered solutions.</span></h2></div><a href="/work" class="text-link">All work <span aria-hidden="true">↗</span></a></div>
  <div class="featured-stories">{work.map((project, index) => <article class:list={['featured-story', `featured-${project.data.visual}`]}>
    <div class="featured-media" data-project-preview={project.id}>{project.data.video ? <VideoPreview src={project.data.video} label="Malaffi silent interface walkthrough" /> : project.data.visual === 'ai' ? <WorkflowPreview /> : <ProjectVisual variant={project.data.visual} />}</div>
    <div class="featured-story-caption"><div><p class="eyebrow">{String(index + 1).padStart(2,'0')} / {project.data.eyebrow} {project.data.editorial && <span class="sample-label">· Story preview</span>}</p><a href={`/work/${project.id}`} data-track="Case study open"><h3>{project.data.visual === 'health' ? 'A health record. A human perspective.' : 'Good design shouldn’t get lost in delivery.'}<span aria-hidden="true">↗</span></h3></a></div><div><p>{project.data.summary}</p><a class="text-link" href={`/work/${project.id}`} data-track="Case study open">Inside the {project.data.visual === 'health' ? 'Malaffi' : 'AI delivery'} story <span aria-hidden="true">→</span></a></div></div>
  </article>)}</div>
</section>
