---
const companies = [
  { name: "Malaffi" },
  { name: "Department of Health" },
  { name: "ADAFSA, Abu Dhabi" },
  { name: "Landmark Group" },
  { name: "Fab.com" },
];
---

<section class="border-y py-8" data-animate>
  <div class="container max-w-screen-lg">
    <p class="text-xs uppercase tracking-widest text-muted-foreground mb-6">
      Organisations I've designed for
    </p>
    <div class="flex flex-wrap items-center gap-x-10 gap-y-4">
      {companies.map((company, i) => (
        <span
          class="text-sm font-medium text-muted-foreground/50 hover:text-muted-foreground transition-colors duration-300 whitespace-nowrap"
          data-animate
          data-delay={String(Math.min(i + 1, 4))}
        >
          {company.name}
        </span>
      ))}
    </div>
  </div>
</section>
