---
import { cn } from "@/lib/utils";
import { buttonVariants } from "@/components/ui/button";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";
---

<section class="py-16 sm:py-24 lg:py-28">
  <div class="container max-w-4xl">

    <!-- Availability kicker -->
    <p class="hero-1 mb-8 flex items-center gap-2.5 text-[13px] font-medium text-muted-foreground">
      <span class="availability-dot" aria-hidden="true"></span>
      Open to lead design roles · Abu Dhabi
    </p>

    <!-- Editorial headline -->
    <h1
      class="hero-1 text-balance font-heading leading-[1.05] tracking-[0.01em]
             text-[clamp(2.5rem,7.5vw,5rem)]"
    >
      Design leader for healthcare systems used by
      <span class="serif-accent">3M+ people</span>.
    </h1>

    <!-- Subhead -->
    <p class="hero-2 mt-7 max-w-2xl text-balance text-base leading-relaxed text-muted-foreground sm:text-lg sm:leading-8">
      I'm Abhishek Rawat. I lead design teams building clinical systems —
      aligning product, engineering and leadership around what patients and
      clinicians actually need.
    </p>

    <!-- CTAs -->
    <div class="hero-3 mt-9 flex flex-wrap items-center gap-3">
      <a
        href={siteConfig.links.linkedin}
        class={cn(buttonVariants({ size: "lg", rounded: "full" }), "gap-2 group")}
      >
        <span>Visit LinkedIn</span>
        <Icon name="lucide:arrow-right" class="size-4 transition-transform duration-300 group-hover:translate-x-0.5" />
      </a>
      <a
        href={siteConfig.links.resume}
        target="_blank"
        rel="noreferrer"
        class={cn(
          buttonVariants({ variant: "outline", size: "lg", rounded: "full" }),
          "px-5 group"
        )}
      >
        <Icon name="download" class="mr-2 size-4 transition-transform duration-300 group-hover:translate-y-0.5" />
        <span class="sm:inline-block">Download Resume</span>
      </a>
    </div>

  </div>
</section>
