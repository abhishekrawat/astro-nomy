---
import ProjectVisual from '@/components/project-visual.astro';
import { portfolio } from '@/config/portfolio';
---
<section class="portfolio-hero shell">
  <div class="hero-copy"><p class="eyebrow hero-1"><span class="availability-dot" aria-hidden="true"></span> Healthcare product design lead</p>
    <h1 class="hero-1"><span class="hero-line">Care, made clear.</span> <span class="hero-line">Delivery, made better.</span></h1>
    <p class="hero-description hero-2">I’m Abhishek. I bring clarity to complex healthcare experiences—and use AI to help teams turn good decisions into working products.</p>
    <div class="hero-buttons hero-3"><a href="#selected-work" class="button-primary">Explore my work <span aria-hidden="true">↓</span></a><a href={`mailto:${portfolio.email}`} class="text-link" data-track="Contact">Let’s talk ↗</a></div>
    <p class="hero-location">Based in Abu Dhabi <span aria-hidden="true">/</span> {portfolio.availability}</p>
  </div>
  <div class="hero-work hero-2"><a href="/work/malaffi-health-portal" aria-label="Explore the Malaffi Health Portal case study" data-track="Case study open"><ProjectVisual variant="health" eager /></a><div class="hero-work-caption"><div><span class="eyebrow">Selected work / Malaffi</span><strong>A clearer view of your health.</strong></div><a href="/work/malaffi-health-portal" aria-label="Read the Malaffi story" class="circle-link">↗</a></div><div class="hero-note"><span class="note-mark" aria-hidden="true">↳</span><span>Healthcare expertise.<br/>A builder’s mindset.</span></div></div>
</section>
