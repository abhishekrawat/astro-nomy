---
import { getCategories } from "@/lib/fetchers";
import { cn } from "@/lib/utils";

type Props = {
  title: string;
  count?: number;
};

const { title, count } = Astro.props;
const { category } = Astro.params;
const categories = await getCategories();
---

<div class="mb-12" data-animate>
  <div class="flex items-end justify-between mb-6">
    <div>
      <p class="text-xs uppercase tracking-widest text-muted-foreground/50 mb-2 font-medium">
        Writing
      </p>
      <h1 class="font-heading text-4xl sm:text-5xl tracking-tight">{title}</h1>
    </div>
    {count !== undefined && (
      <span class="text-sm text-muted-foreground mb-1 hidden sm:block">
        {count} post{count !== 1 ? "s" : ""}
      </span>
    )}
  </div>

  {categories?.length > 0 && (
    <div class="flex flex-wrap items-center gap-2" role="navigation" aria-label="Filter by category">
      <a
        href="/blog"
        class={cn(
          "text-xs px-3 py-1 rounded-full font-medium transition-colors duration-200",
          !category
            ? "bg-foreground text-background"
            : "bg-muted text-muted-foreground hover:text-foreground hover:bg-muted/80"
        )}
      >
        All
      </a>
      {categories.map((cat) => (
        <a
          href={`/blog/category/${cat}`}
          class={cn(
            "text-xs px-3 py-1 rounded-full font-medium capitalize transition-colors duration-200",
            cat === category
              ? "bg-foreground text-background"
              : "bg-muted text-muted-foreground hover:text-foreground hover:bg-muted/80"
          )}
        >
          {cat}
        </a>
      ))}
    </div>
  )}
</div>
