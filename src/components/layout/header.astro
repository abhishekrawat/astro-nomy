---
import { siteConfig } from "@/config/site";
import { cn } from "@/lib/utils";

type Props = {
  className?: string;
};

const { className } = Astro.props;
---

<header
  id="site-header"
  transition:name="site-header"
  transition:animate="none"
  class={cn(
    "flex items-center h-16 z-50 sticky top-0 border-b",
    className
  )}
>
  <div class="relative container max-w-screen-lg flex items-center justify-between w-full">

    <!-- Left: logo + desktop nav -->
    <div class="flex items-center gap-6 md:gap-8">
      <a
        href="/"
        class="hidden md:inline-flex items-center text-sm font-semibold hover:opacity-70 transition-opacity duration-200"
        aria-label={`${siteConfig.name} — home`}
      >
        {siteConfig.name}
      </a>

      <!-- Mobile nav trigger (sheet) -->
      <slot name="mobile-nav-header" />

      <!-- Desktop nav links -->
      <div class="hidden md:flex">
        <slot name="left-header" />
      </div>
    </div>

    <!-- Mobile: centered name -->
    <a
      href="/"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 md:hidden text-sm font-semibold hover:opacity-70 transition-opacity duration-200 whitespace-nowrap"
      aria-label="Home"
    >
      {siteConfig.name}
    </a>

    <!-- Right: actions -->
    <slot name="right-header" />

  </div>
</header>

<!-- Scroll-aware header: frosted glass when page is scrolled -->
<script is:inline>
  function syncHeaderScroll() {
    var h = document.getElementById("site-header");
    if (h) h.classList.toggle("header-scrolled", window.scrollY > 10);
  }
  if (!window.__headerScrollSetup) {
    window.__headerScrollSetup = true;
    window.addEventListener("scroll", syncHeaderScroll, { passive: true });
    // astro:after-swap: new DOM is in place, sync before transition animates in
    document.addEventListener("astro:after-swap", syncHeaderScroll);
    // astro:page-load: fires after transitions complete
    document.addEventListener("astro:page-load", syncHeaderScroll);
  }
  syncHeaderScroll();
</script>
